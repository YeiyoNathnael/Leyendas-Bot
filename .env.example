# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# Turso (libSQL) Database Configuration
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Notion API Configuration
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_TASKS_DB_ID=your_tasks_database_id_here
NOTION_TEAM_DB_ID=your_the_team_database_id_here
NOTION_MEETINGS_DB_ID=your_meetings_database_id_here

# Google GenAI / Gemma 4 31B Configuration
GEMINI_API_KEY=your_google_genai_api_key_here
GEMMA_MODEL_NAME=gemma-4-31b

# Google Calendar & Meet OAuth Configuration
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8085/oauth/callback
GOOGLE_REFRESH_TOKEN=your_generated_google_refresh_token_here

# Bot Scheduling & Polling Configuration
STANDUP_CRON="0 9 * * 1-5"
STANDUP_DIGEST_CRON="0 15 * * 1-5"
NOTION_POLL_INTERVAL=5m
DEADLINE_CHECK_INTERVAL=15m
